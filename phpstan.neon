parameters:
    # Subir de nivel se hace de uno en uno y dejando el análisis en verde.
    # Al pasar de 2 a 3 salieron dos firmas mal documentadas: eliminar()
    # declaraba devolver bool y devuelve una lista de archivos, y
    # procesar_logo() declaraba string aunque su propia descripción decía
    # "o null si falla". El nivel 4 deja 13 avisos; queda para otra vuelta.
    level: 3

    bootstrapFiles:
        - phpstan-bootstrap.php

    # El proyecto no usa autoload de Composer para sus propias clases (todo es
    # require_once, sin namespaces) — scanDirectories deja que PHPStan resuelva
    # clases y constantes definidas en otros archivos sin necesidad de autoload.
    scanDirectories:
        - app
        - lib
        - configuracion

    paths:
        - app/controladores
        - app/modelos
        - app/servicios
        - lib
        - configuracion
        - public/index.php

    # app/vistas se excluye: son plantillas que reciben variables vía extract($datos)
    # en el controlador, así que PHPStan las reportaría todas como "variable indefinida"
    # sin que sea un bug real.
    excludePaths:
        - app/vistas/*
